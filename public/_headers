# Intestazioni per l'hosting (Netlify e Cloudflare Pages leggono questo file).

# Il service worker va sempre ricontrollato, così gli aggiornamenti arrivano subito.
/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Content-Type: application/manifest+json

# Collegamento tra il sito e l'app del Play Store (file aggiunto in fase di pubblicazione).
/.well-known/assetlinks.json
  Content-Type: application/json
  Access-Control-Allow-Origin: *

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
